[Unit]
Description=Affichage de la borne Badgeuse (cage + Chromium en plein écran)
After=systemd-user-sessions.service badgeuse-kiosk.service
Wants=badgeuse-kiosk.service
# L'écran de connexion de la console 1 laisse la place à l'affichage.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=badgeuse-display
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
UtmpIdentifier=tty1
UtmpMode=user
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# Le serveur d'affichage répond sur 127.0.0.1:8080 ; Chromium ne charge rien d'autre.
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-translate --user-data-dir=/tmp/badgeuse-display --disk-cache-dir=/dev/null --ozone-platform=wayland --disable-background-networking --disable-component-update --disable-sync --disable-breakpad --disable-crash-reporter --disable-default-apps --disable-extensions --disable-dev-shm-usage --disable-features=Translate,MediaRouter,OptimizationHints,InterestFeedContentSuggestions --no-pings --noproxy-server --autoplay-policy=no-user-gesture-required --renderer-process-limit=1 --js-flags=--max-old-space-size=48 http://127.0.0.1:8080
Restart=always
RestartSec=3
# Le lecteur NFC passe avant l'affichage quand le Pi est chargé.
Nice=5
MemoryMax=450M

[Install]
WantedBy=multi-user.target
