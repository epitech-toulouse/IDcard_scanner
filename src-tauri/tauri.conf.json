{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Badgeuse",
  "version": "0.1.0",
  "identifier": "fr.badgeuse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Badgeuse",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "Émargement des étudiants par carte NFC",
    "createUpdaterArtifacts": true,
    "resources": { "resources/kiosk/": "kiosk/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["pcscd", "libccid"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RkQ2MzRFOTk2MTdBRjIKUldUeWVtR1pUbVA5dC9hWWcwRHFZMFZzaDdYYjUyYjVLVGdDU1NKUjhBeXk2aTNrVitrOGdReG8K",
      "endpoints": ["https://github.com/epitech-toulouse/IDcard_scanner/releases/latest/download/latest.json"]
    }
  }
}
